#!/usr/bin/env python
# -*- coding: utf-8 -*-
"""
merge-first-roles: Merges first_author.tex (auto-generated from ADS)
with first_author_roles.tex (manually maintained role descriptions keyed by
arXiv ID) to produce first_author_full.tex, used only by cv_full.tex.

Run from the repo root or from the tex/ directory:
    python scripts/merge-first-roles
    cd tex && make first_author_full.tex
"""

import importlib.machinery
import importlib.util
import os
import sys

here = os.path.dirname(os.path.abspath(__file__))
tex_dir = os.path.join(here, "..", "tex")
loader = importlib.machinery.SourceFileLoader(
    "merge_sig_roles", os.path.join(here, "merge-sig-roles")
)
spec = importlib.util.spec_from_loader(loader.name, loader)
merge_sig_roles = importlib.util.module_from_spec(spec)
loader.exec_module(merge_sig_roles)


def main():
    papers_path = os.path.join(tex_dir, "first_author.tex")
    roles_path = os.path.join(tex_dir, "first_author_roles.tex")
    output_path = os.path.join(tex_dir, "first_author_full.tex")

    try:
        papers = merge_sig_roles.load_papers(papers_path)
        roles = merge_sig_roles.load_roles(roles_path)
        paper_roles = merge_sig_roles.pair_papers_with_roles(papers, roles)
    except ValueError as error:
        print(f"ERROR: {error}", file=sys.stderr)
        sys.exit(1)

    blocks = []
    for paper, role in paper_roles:
        blocks.append(paper)
        blocks.append("")
        blocks.append("\\vspace{1mm}")
        blocks.append("\\item\\textit{\\underline{My role:} " + role + "}")
        blocks.append("\\vspace{1mm}")
        blocks.append("")

    with open(output_path, "w") as f:
        f.write("\n".join(blocks))

    print(
        f"Written {os.path.basename(output_path)} "
        f"({len(papers)} papers with roles)"
    )


if __name__ == "__main__":
    main()
