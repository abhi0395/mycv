#!/usr/bin/env python
# -*- coding: utf-8 -*-

import argparse
import os
import json
import importlib.util
from operator import itemgetter
import re

def fix_latex_typesetting(sorted_papers):
    for papers in sorted_papers:
        title = papers["title"]
        title = (title
                 .replace('{\\&}lt;', '<')
                 .replace('{\\&}gt;', '>')
                 .replace('{\\&}amp;', '&')
                 .replace('<inline-formula><mml:math><mml:mrow><mml:mi>Ly</mml:mi><mml:mi>{\\ensuremath{\\alpha}}</mml:mi></mml:mrow></mml:math></inline-formula>', 'Ly${\\ensuremath{\\alpha}}$')
                 .replace('<inline-formula><mml:math><mml:mrow><mml:mrow><mml:mrow><mml:mi>Ly</mml:mi><mml:mi>{\\ensuremath{\\alpha}}</mml:mi></mml:mrow></mml:mrow></mml:mrow></mml:math></inline-formula>', 'Ly${\\ensuremath{\\alpha}}$'))
        papers["title"] = title
    return sorted_papers

def remove_arxiv_duplicates(sorted_papers):
    """Deduplicate by title and first author, preferring published records."""
    def normalize_title(title):
        title = ' '.join(title.casefold().replace('$', '').split())
        return re.sub(r'\s*~\s*', '~', title)

    papers_by_key = {}

    for item in sorted_papers:
        if item["doctype"] in ["inproceedings", "phdthesis"]:
            continue
        title = normalize_title(item["title"])
        authors = item["authors"]
        if not title or not authors or not authors[0].strip():
            raise ValueError("A paper must have a title and first author for deduplication")
        first_author = ' '.join(authors[0].casefold().split())
        key = (title, first_author)

        if key not in papers_by_key:
            papers_by_key[key] = item
            continue

        existing = papers_by_key[key]
        existing_published = existing["volume"] is not None
        item_published = item["volume"] is not None
        replace = (item_published and not existing_published) or (
            not existing_published and not item_published
            and item["pubdate"] > existing["pubdate"]
        )
        kept, removed = (item, existing) if replace else (existing, item)
        if not kept.get("arxiv") and removed.get("arxiv"):
            kept["arxiv"] = removed["arxiv"]
        papers_by_key[key] = kept

    return sorted(papers_by_key.values(), key=itemgetter("pubdate"), reverse=True)


here = os.path.dirname(os.path.abspath(__file__))
spec = importlib.util.spec_from_file_location(
    "utf8totex", os.path.join(here, "utf8totex.py")
)
utf8totex = importlib.util.module_from_spec(spec)
spec.loader.exec_module(utf8totex)

def get_papers(author):
    import ads

    query = ads.SearchQuery(
        author=author,
        q='galaxy',
        fl=[
            "id",
            "title",
            "author",
            "doi",
            "year",
            "pubdate",
            "pub",
            "volume",
            "page",
            "identifier",
            "doctype",
            "citation_count",
            "bibcode",
        ],
        max_pages=100,
    )
    papers = []
    while True:
        try:
            papers.append(next(query))
        except StopIteration:
            break
        except IndexError:
            # ads library bug: IndexError raised instead of StopIteration
            # when results are exhausted
            break
    dicts = []
    for paper in papers:
        if paper.identifier is None:
            continue
        aid = [
            ":".join(t.split(":")[1:])
            for t in paper.identifier
            if t.startswith("arXiv:")
        ]
        for t in paper.identifier:
            if len(t.split(".")) != 2:
                continue
            try:
                list(map(int, t.split(".")))
            except ValueError:
                pass
            else:
                aid.append(t)
        try:
            page = paper.page[0]
        except (ValueError, TypeError):
            page = None
            if paper.page is not None and paper.page[0].startswith("arXiv:"):
                aid.append(":".join(paper.page[0].split(":")[1:]))

        keywords = ["LIGO", "Virgo", "KAGRA", "LiteBIRD", "GWTC-5.0", "Gravitational-Wave"]

        if not any(word.lower() in paper.title[0].lower() for word in keywords) and (paper.doctype!="phdthesis"):

            dicts.append(
                dict(
                    doctype=paper.doctype,
                    authors=list(map(utf8totex.utf8totex, paper.author)),
                    year=paper.year,
                    pubdate=paper.pubdate,
                    doi=paper.doi[0] if paper.doi is not None else None,
                    title=utf8totex.utf8totex(paper.title[0].replace(" &amp; ", " & ")),
                    pub=paper.pub,
                    volume=paper.volume,
                    page=page,
                    arxiv=aid[0] if len(aid) else None,
                    citations=(
                        paper.citation_count if paper.citation_count is not None else 0
                    ),
                    url="https://ui.adsabs.harvard.edu/abs/" + paper.bibcode,
                )
            )
        else:
            continue
    return sorted(dicts, key=itemgetter("pubdate"), reverse=True)


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Update the astronomy publication list.")
    parser.add_argument(
        "--deduplicate-existing", action="store_true",
        help="deduplicate data/pubs.json without fetching from ADS",
    )
    args = parser.parse_args()
    if args.deduplicate_existing:
        with open("data/pubs.json") as f:
            papers = json.load(f)
    else:
        papers = get_papers("Anand, Abhijeet")
    papers = remove_arxiv_duplicates(fix_latex_typesetting(papers))
    with open("data/pubs.json", "w") as f:
        json.dump(papers, f, sort_keys=True, indent=2, separators=(",", ": "))
